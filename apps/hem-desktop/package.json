{
  "name": "hem-desktop",
  "productName": "Hem Desk",
  "version": "0.1.0",
  "description": "Keyboard-first macOS desktop app for the Hem secret vault and mesh",
  "type": "module",
  "main": "out/main/index.js",
  "private": true,
  "author": "Tormod Haugland <tormod.haugland@gmail.com>",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint src tests",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource/geist-mono": "^5.2.8",
    "@fontsource/geist-sans": "^5.2.5",
    "@grpc/grpc-js": "^1.14.0",
    "@grpc/proto-loader": "^0.8.0",
    "@stylexjs/stylex": "^0.19.0",
    "@tanstack/react-query": "^5.90.0",
    "execa": "^9.6.0",
    "nats": "^2.29.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@stylexjs/babel-plugin": "^0.19.0",
    "@stylexjs/postcss-plugin": "^0.19.0",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "^43.0.0",
    "electron-vite": "^5.0.0",
    "eslint": "^9.39.0",
    "puppeteer-core": "^25.3.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.48.0",
    "vite": "^7.2.0",
    "vitest": "^4.1.0"
